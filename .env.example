# ==============================================================================
# CLUB BOOKING BACKEND CONFIGURATION
# Copy this file to .env and adjust variables as needed.
# For local development, default values are pre-configured to work out of the box.
# ==============================================================================

# --- DJANGO CORE SETTINGS ---
DJANGO_SECRET_KEY=django-insecure-local-development-only-change-before-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_ALL_ORIGINS=true

# --- SECURITY (Set to true in production with HTTPS) ---
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_USE_X_FORWARDED_PROTO=false
DJANGO_AUDIT_ASYNC=true

# --- DATABASE CONFIGURATION ---
# Leave DB_ENGINE empty or unset to use SQLite (zero-setup local dev)
# Set DB_ENGINE=postgresql for PostgreSQL (e.g. Docker / Production)
DB_ENGINE=
DB_NAME=club_booking
DB_USER=club_booking
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- REDIS / CACHE CONFIGURATION ---
# Optional in local development (falls back to DatabaseCache)
# Example: redis://127.0.0.1:6379/1
REDIS_URL=

# --- TELEGRAM BOT CONFIGURATION ---
# Bot token and username obtained from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINIAPP_URL=http://localhost:3000

# --- OTP & SMS NOTIFICATION CONFIGURATION ---
# Options for OTP_DELIVERY_BACKEND: console, sms
OTP_DELIVERY_BACKEND=console
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER=ClubBooking
SMS_API_TIMEOUT_SECONDS=10

# --- PAYMENT PROVIDER CONFIGURATION ---
# Options for PAYMENT_PROVIDER: manual, http, click, payme
PAYMENT_PROVIDER=manual
PAYMENT_API_URL=
PAYMENT_API_TOKEN=
PAYMENT_API_TIMEOUT_SECONDS=10
PAYMENT_WEBHOOK_SECRET=local-development-webhook-secret
PAYMENT_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/webhook/
PAYMENT_RETURN_URL=http://localhost:3000/profile

# --- CLOUDFLARE TURNSTILE (CAPTCHA) ---
TURNSTILE_SECRET_KEY=
