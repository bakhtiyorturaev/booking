# ==============================================================================
# CLUB BOOKING FRONTEND (Nuxt 4) CONFIGURATION
# Copy this file to .env in frontend/ directory if custom overrides are needed.
# ==============================================================================

# Public API base URL used by browser client (e.g. http://127.0.0.1:8000/api/v1 or https://api.yourdomain.com/api/v1)
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Django API base URL used by Nitro SSR server (e.g. http://127.0.0.1:8000/api/v1 or http://backend:8000/api/v1 in Docker)
NUXT_DJANGO_API_BASE_URL=http://127.0.0.1:8000/api/v1
